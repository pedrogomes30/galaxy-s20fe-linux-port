#!/bin/sh
# Cadastra uma digital pelo droidian-fpd e mostra o progresso.
# uso: sudo r8q-fp-enroll [nome-do-dedo] [tempo-limite-s]
F=${1:-polegar-direito}; T=${2:-180}
DEST="--system --dest org.droidian.fingerprint --object-path /org/droidian/fingerprint"
echo "Cadastrando digital '$F'."
echo "Encoste o dedo na parte de baixo da tela, no centro, cerca de 3 cm acima da borda."
echo "Levante e encoste de novo varias vezes, mudando um pouco a posicao, ate chegar a 100%."
gdbus monitor $DEST 2>/dev/null | while read -r line; do
  case "$line" in
    *EnrollProgressChanged*) p=$(echo "$line" | grep -oE "\(([0-9]+)," | tr -dc 0-9); echo "Progresso: ${p}%";;
    *AcquisitionInfo*) echo "Aviso do leitor: $(echo "$line" | grep -oE "'[^']*'")";;
    *ErrorInfo*) echo "Erro do leitor: $(echo "$line" | grep -oE "'[^']*'")";;
    *.Added*) echo "Digital cadastrada: $(echo "$line" | grep -oE "'[^']*'")"; pkill -P $$ gdbus 2>/dev/null; break;;
    *.Failed*|*.Aborted*) echo "O cadastro falhou ou foi cancelado."; break;;
  esac
done &
MON=$!
sleep 1
gdbus call $DEST --method org.droidian.fingerprint.Enroll "$F" >/dev/null 2>&1 || echo "Nao foi possivel iniciar o cadastro."
i=0; while kill -0 $MON 2>/dev/null && [ $i -lt $T ]; do sleep 1; i=$((i+1)); done
kill $MON 2>/dev/null; pkill -f "gdbus monitor --system --dest org.droidian.fingerprint" 2>/dev/null
[ $i -ge $T ] && { echo "Tempo esgotado."; gdbus call $DEST --method org.droidian.fingerprint.Abort >/dev/null 2>&1; }
echo "Digitais cadastradas: $(gdbus call $DEST --method org.droidian.fingerprint.GetAll 2>/dev/null)"
